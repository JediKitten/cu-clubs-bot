# Copy to .env. Local development credentials below are not production credentials.
CU_CLUBS_ENVIRONMENT=local
CU_CLUBS_HOST=127.0.0.1
CU_CLUBS_PORT=8000
CU_CLUBS_DATABASE_URL=postgresql+psycopg://cu_clubs:local-dev-only@127.0.0.1:5432/cu_clubs
CU_CLUBS_READINESS_TIMEOUT_SECONDS=3
CU_CLUBS_TIMEZONE=Europe/Moscow

# JSON array of numeric Telegram IDs. Resolve owners out of band before bootstrap.
# Reference usernames only: @yaroslavakir, @jedi_kitten. Never authorize by username.
CU_CLUBS_BOOTSTRAP_ADMIN_IDS=[]
CU_CLUBS_BOOTSTRAP_LEADER_TELEGRAM_ID=
# Temporary test-only exception. Never enables student email verification.
CU_CLUBS_TEST_ALLOW_UNVERIFIED_LEADERS=false

# Keep false locally. Explicitly enable only for the selected test bot deployment.
CU_CLUBS_EXTERNAL_DELIVERY_ENABLED=false
CU_CLUBS_TELEGRAM_BOT_TOKEN=
CU_CLUBS_TELEGRAM_BOT_USERNAME=
CU_CLUBS_TELEGRAM_WEBHOOK_SECRET=
CU_CLUBS_TELEGRAM_WEBHOOK_URL=
# webhook for the intended deployment; polling is available for the initial test server.
CU_CLUBS_TELEGRAM_TRANSPORT=webhook

CU_CLUBS_SMTP_HOST=
CU_CLUBS_SMTP_PORT=587
CU_CLUBS_SMTP_USERNAME=
CU_CLUBS_SMTP_PASSWORD=
CU_CLUBS_SMTP_SENDER=
CU_CLUBS_SMTP_USE_SSL=false
CU_CLUBS_SMTP_STARTTLS=true
# At least 32 random characters. Required for real verification and encrypted inbox.
# Preserve the same key during ordinary deploys and restores; never commit a value.
CU_CLUBS_VERIFICATION_SECRET=

# User OAuth initially; later service_account. Runtime credential JSON stays outside repo.
CU_CLUBS_GOOGLE_AUTH_MODE=oauth
CU_CLUBS_GOOGLE_CREDENTIALS_PATH=
CU_CLUBS_GOOGLE_SPREADSHEET_ID=
CU_CLUBS_GOOGLE_SHEET_NAME=Calendar 2026
# Writes require environment=test and an exact match with GOOGLE_SPREADSHEET_ID.
CU_CLUBS_CALENDAR_SYNC_ENABLED=false
CU_CLUBS_CALENDAR_ALLOW_WRITES=false
CU_CLUBS_CALENDAR_TEST_SPREADSHEET_ID=
CU_CLUBS_CALENDAR_SYNC_INTERVAL_SECONDS=60
CU_CLUBS_CALENDAR_SYNC_BATCH_SIZE=10

# Daily PostgreSQL snapshots; enable only with a configured numeric owner ID.
CU_CLUBS_BACKUP_RECIPIENT_TELEGRAM_ID=
CU_CLUBS_BACKUP_CRON=0 3 * * *
CU_CLUBS_BACKUP_DIRECTORY=backups
CU_CLUBS_BACKUPS_ENABLED=false

# Local Compose PostgreSQL only. Change together with DATABASE_URL if needed.
POSTGRES_USER=cu_clubs
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=cu_clubs
